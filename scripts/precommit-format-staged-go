#!/usr/bin/env bash
set -euo pipefail

# The Makefile's pinned golangci-lint, which make installs into
# $(go env GOPATH)/bin when it is missing or stale; that directory need not be
# on PATH. GOLANGCI_LINT names another binary, as it does for make.
golangci_lint="${GOLANGCI_LINT:-}"
if [ -z "$golangci_lint" ]; then
  make -s golangci-lint-pinned </dev/null >&2
  golangci_lint="$(go env GOPATH)/bin/golangci-lint"
fi

status=0

while IFS= read -r file; do
  if [ -z "$file" ] || [ ! -f "$file" ]; then
    continue
  fi

  tmp=$(mktemp "${TMPDIR:-/tmp}/gc-precommit-fmt.XXXXXX")
  if ! "$golangci_lint" fmt --stdin <"$file" >"$tmp"; then
    rm -f "$tmp"
    status=1
    continue
  fi

  if cmp -s "$file" "$tmp"; then
    rm -f "$tmp"
    continue
  fi

  cat "$tmp" >"$file"
  rm -f "$tmp"
done

if [ "$status" -ne 0 ]; then
  echo "pre-commit: golangci-lint fmt failed for one or more staged Go files" >&2
fi

exit "$status"
