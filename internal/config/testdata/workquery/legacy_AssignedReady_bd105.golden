sh -c 'gc_id_seen1=""; gc_id_seen2=""; for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; case "$id" in *[![:space:]]*) ;; *) continue ;; esac; [ "$id" = "$gc_id_seen1" ] && continue; [ "$id" = "$gc_id_seen2" ] && continue; if [ -z "$gc_id_seen1" ]; then gc_id_seen1="$id"; else gc_id_seen2="$id"; fi; legacy=""; case "$id" in *control-dispatcher) legacy="${id%control-dispatcher}workflow-control";; esac; for cand in "$id" "$legacy"; do [ -z "$cand" ] && continue; r=$(bd ready --include-ephemeral --assignee="$cand" --json --limit=1) || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''bd'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd ready failed'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; gc_window=$(printf "%s" "$r" | jq -c '\''if type != "array" then error("not an array") else ([.[] | select((([ (.labels // [])[] | select(((tostring | gsub("^\\s+|\\s+$"; "")) as $gc_label | ($gc_label | ascii_downcase | startswith("hold:")) and (($gc_label | .[5:] | gsub("^\\s+|\\s+$"; "") | ascii_downcase) as $gc_value | $gc_value != "" and $gc_value != "cleared"))) ] | length) > 0) | not) | select(((((.metadata["gc.exclude_claimants"] // "") | tostring | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))) as $gc_ex | [$ENV.GC_SESSION_ID, $ENV.GC_SESSION_NAME, $ENV.GC_ALIAS, $ENV.GC_AGENT] | any(.[]; (. // "") as $gc_id | $gc_id != "" and any($gc_ex[]; . == $gc_id)))) | not)] as $gc_kept | if length >= 1 and ($gc_kept | length) < length then "widen" else $gc_kept end) end'\'' 2>/dev/null); if [ "$gc_window" = '\''"widen"'\'' ]; then r=$(bd ready --include-ephemeral --assignee="$cand" --json --limit=0) || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''bd'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd ready failed'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; gc_window=$(printf "%s" "$r" | jq -c '\''[.[] | select((([ (.labels // [])[] | select(((tostring | gsub("^\\s+|\\s+$"; "")) as $gc_label | ($gc_label | ascii_downcase | startswith("hold:")) and (($gc_label | .[5:] | gsub("^\\s+|\\s+$"; "") | ascii_downcase) as $gc_value | $gc_value != "" and $gc_value != "cleared"))) ] | length) > 0) | not) | select(((((.metadata["gc.exclude_claimants"] // "") | tostring | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))) as $gc_ex | [$ENV.GC_SESSION_ID, $ENV.GC_SESSION_NAME, $ENV.GC_ALIAS, $ENV.GC_AGENT] | any(.[]; (. // "") as $gc_id | $gc_id != "" and any($gc_ex[]; . == $gc_id)))) | not)] | .[:1]'\'' 2>/dev/null); fi; [ -n "$gc_window" ] && r="$gc_window"; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; done; done; printf "[]"'