sh -c 'gc_id_seen1=""; gc_id_seen2=""; for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; case "$id" in *[![:space:]]*) ;; *) continue ;; esac; [ "$id" = "$gc_id_seen1" ] && continue; [ "$id" = "$gc_id_seen2" ] && continue; if [ -z "$gc_id_seen1" ]; then gc_id_seen1="$id"; else gc_id_seen2="$id"; fi; r=$(bd list --status in_progress --assignee="$id" --json --limit=1) || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''bd'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd list --status in_progress failed'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; gc_window=$(printf "%s" "$r" | jq -c '\''if type != "array" then error("not an array") else ([.[] | select((([ (.labels // [])[] | select(((tostring | gsub("^\\s+|\\s+$"; "")) as $gc_label | ($gc_label | ascii_downcase | startswith("hold:")) and (($gc_label | .[5:] | gsub("^\\s+|\\s+$"; "") | ascii_downcase) as $gc_value | $gc_value != "" and $gc_value != "cleared"))) ] | length) > 0) | not) | select(((((.metadata["gc.exclude_claimants"] // "") | tostring | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))) as $gc_ex | [$ENV.GC_SESSION_ID, $ENV.GC_SESSION_NAME, $ENV.GC_ALIAS, $ENV.GC_AGENT] | any(.[]; (. // "") as $gc_id | $gc_id != "" and any($gc_ex[]; . == $gc_id)))) | not)] as $gc_kept | if length >= 1 and ($gc_kept | length) < length then "widen" else $gc_kept end) end'\'' 2>/dev/null); if [ "$gc_window" = '\''"widen"'\'' ]; then r=$(bd list --status in_progress --assignee="$id" --json --limit=0) || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''bd'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd list --status in_progress failed'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; gc_window=$(printf "%s" "$r" | jq -c '\''[.[] | select((([ (.labels // [])[] | select(((tostring | gsub("^\\s+|\\s+$"; "")) as $gc_label | ($gc_label | ascii_downcase | startswith("hold:")) and (($gc_label | .[5:] | gsub("^\\s+|\\s+$"; "") | ascii_downcase) as $gc_value | $gc_value != "" and $gc_value != "cleared"))) ] | length) > 0) | not) | select(((((.metadata["gc.exclude_claimants"] // "") | tostring | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))) as $gc_ex | [$ENV.GC_SESSION_ID, $ENV.GC_SESSION_NAME, $ENV.GC_ALIAS, $ENV.GC_AGENT] | any(.[]; (. // "") as $gc_id | $gc_id != "" and any($gc_ex[]; . == $gc_id)))) | not)] | .[:1]'\'' 2>/dev/null); fi; [ -n "$gc_window" ] && r="$gc_window"; if [ -n "$r" ] && [ "$r" != "[]" ]; then bid=$(printf "%s" "$r" | jq -r ".[0].id // empty" 2>/dev/null); bb="[]"; [ -n "$bid" ] && bb=$(bd show "$bid" --json 2>/dev/null | jq -c '\''[.[0].dependencies[]? | select(.dependency_type == "blocks" or .dependency_type == "waits-for" or .dependency_type == "conditional-blocks") | {id, status}]'\'' 2>/dev/null); [ -z "$bb" ] && bb="[]"; nblocked=$(printf "%s" "$bb" | jq -r '\''[.[] | select(((.status // "") | ascii_downcase) != "closed")] | length'\'' 2>/dev/null); [ -z "$nblocked" ] && nblocked=0; if [ "$nblocked" = "0" ]; then r_enriched=$(printf "%s" "$r" | jq -c --argjson bb "$bb" '\''map(. + {blocked_by: $bb})'\'' 2>/dev/null); [ -n "$r_enriched" ] && [ "$r_enriched" != "[]" ] && r="$r_enriched"; printf "%s" "$r" && exit 0; fi; fi; [ -n "${in_progress_ephemeral_set:-}" ] || { in_progress_ephemeral=$(bd query --json '\''ephemeral=true AND status=in_progress'\'' --limit=0) || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''bd'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd query failed'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; printf "%s" "$in_progress_ephemeral" | jq empty >/dev/null 2>&1 || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''jq'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd query output is not valid JSON'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; in_progress_ephemeral_set=1; }; r=$(printf "%s" "$in_progress_ephemeral" | jq --arg id "$id" '\''[.[] | select((.assignee // "") == $id) | select((([ (.labels // [])[] | select(((tostring | gsub("^\\s+|\\s+$"; "")) as $gc_label | ($gc_label | ascii_downcase | startswith("hold:")) and (($gc_label | .[5:] | gsub("^\\s+|\\s+$"; "") | ascii_downcase) as $gc_value | $gc_value != "" and $gc_value != "cleared"))) ] | length) > 0) | not) | select(((.issue_type // .type // "") | tostring | gsub("^\\s+|\\s+$"; "") | ascii_downcase) != "message") | select(((((.metadata["gc.exclude_claimants"] // "") | tostring | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))) as $gc_ex | [$ENV.GC_SESSION_ID, $ENV.GC_SESSION_NAME, $ENV.GC_ALIAS, $ENV.GC_AGENT] | any(.[]; (. // "") as $gc_id | $gc_id != "" and any($gc_ex[]; . == $gc_id)))) | not)] | .[:1]'\'' 2>/dev/null); if [ -n "$r" ] && [ "$r" != "[]" ]; then bid=$(printf "%s" "$r" | jq -r ".[0].id // empty" 2>/dev/null); bb="[]"; [ -n "$bid" ] && bb=$(bd show "$bid" --json 2>/dev/null | jq -c '\''[.[0].dependencies[]? | select(.dependency_type == "blocks" or .dependency_type == "waits-for" or .dependency_type == "conditional-blocks") | {id, status}]'\'' 2>/dev/null); [ -z "$bb" ] && bb="[]"; nblocked=$(printf "%s" "$bb" | jq -r '\''[.[] | select(((.status // "") | ascii_downcase) != "closed")] | length'\'' 2>/dev/null); [ -z "$nblocked" ] && nblocked=0; if [ "$nblocked" = "0" ]; then r_enriched=$(printf "%s" "$r" | jq -c --argjson bb "$bb" '\''map(. + {blocked_by: $bb})'\'' 2>/dev/null); [ -n "$r_enriched" ] && [ "$r_enriched" != "[]" ] && r="$r_enriched"; printf "%s" "$r" && exit 0; fi; fi; done; printf "[]"'