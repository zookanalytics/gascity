sh -c 'target="$1"; ready_json=$(gc ready --include-ephemeral --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "human" --json --limit 0) || exit $?; legacy_candidates=$(gc ready --include-ephemeral --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-label "human" --json --sort oldest --limit 0) || exit $?; legacy_json=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select(((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.workflow_expanded"] // "") != "true"))]'\'') || exit $?; legacy_ephemeral_json="[]"; printf "%s\n%s\n%s\n" "$ready_json" "$legacy_json" "$legacy_ephemeral_json" | jq -s '\''(add // []) | unique_by(.id) | map(select((((.metadata["gc.kind"] // "") | gsub("^\\s+|\\s+$"; "")) != "workflow" or ((.metadata["gc.workflow_expanded"] // "") | gsub("^\\s+|\\s+$"; "")) != "true") and ((.metadata["gc.kind"] // "") | gsub("^\\s+|\\s+$"; "")) != "scope" and ((.metadata["gc.kind"] // "") | gsub("^\\s+|\\s+$"; "")) != "spec") | select((([ (.labels // [])[] | select(((tostring | gsub("^\\s+|\\s+$"; "")) as $gc_label | ($gc_label | ascii_downcase | startswith("hold:")) and (($gc_label | .[5:] | gsub("^\\s+|\\s+$"; "") | ascii_downcase) as $gc_value | $gc_value != "" and $gc_value != "cleared"))) ] | length) > 0) | not)) | length'\''' -- worker-pool